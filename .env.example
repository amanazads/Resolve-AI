# =============================================================================
# RESOLVE AI — ENVIRONMENT CONFIGURATION (.env)
# Autonomous AI Execution Workspace
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM Credentials & Intelligence
# -----------------------------------------------------------------------------
# Google Gemini API key used by the autonomous agent planner and personalization engine.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Optional: HuggingFace Token for open-weight embeddings or local models
# HF_TOKEN=your_huggingface_token_here

# -----------------------------------------------------------------------------
# 2. Database & State Persistence (MongoDB & ChromaDB)
# -----------------------------------------------------------------------------
# MongoDB stores execution tasks, actions, events, audit logs, and idempotency keys.
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_support_db

# Local ChromaDB vector database directory for semantic retrieval and knowledge RAG
CHROMA_PERSIST_DIRECTORY=./chroma_db

# -----------------------------------------------------------------------------
# 3. Application URLs & CORS Security
# -----------------------------------------------------------------------------
# Frontend web application origin(s) allowed for CORS requests
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# 4. File Intelligence & Ingestion Limits
# -----------------------------------------------------------------------------
# Maximum file size per attachment in bytes (default: 25 MB = 26,214,400 bytes)
MAX_FILE_SIZE_BYTES=26214400

# Allowed file formats for document intelligence: PDF, DOCX, CSV, XLSX, TXT, JSON, MD
ALLOWED_FILE_EXTENSIONS=.csv,.xlsx,.xls,.pdf,.docx,.doc,.txt,.json,.md

# -----------------------------------------------------------------------------
# 5. Outbound Execution Provider (Email & Actions)
# -----------------------------------------------------------------------------
# Which email provider is active:
#   mock  -> Zero external network calls. Dry-run simulation and testing.
#   gmail -> Google Gmail API via OAuth 2.0 (requires Google Cloud configuration below).
EMAIL_PROVIDER=mock

# -----------------------------------------------------------------------------
# 6. Gmail Integration — Google Cloud OAuth 2.0
# -----------------------------------------------------------------------------
# Setup in Google Cloud Console (https://console.cloud.google.com):
#   1. Create or select a project and enable the "Gmail API".
#   2. Configure OAuth Consent Screen (add scopes: https://www.googleapis.com/auth/gmail.send, openid, email).
#   3. Create "Web application" Credentials and set Authorized Redirect URI:
#      http://localhost:8000/api/integrations/gmail/callback
#   4. Generate a 32-byte url-safe Fernet encryption key for GMAIL_TOKEN_ENCRYPTION_KEY:
#      python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback

# REQUIRED: 32 url-safe base64 bytes for encrypting OAuth tokens at rest in MongoDB.
# Never commit this key to version control.
GMAIL_TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here

# Scopes requested during OAuth flow
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.metadata openid email

# Frontend destination after completing Google OAuth consent in browser
GMAIL_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/#/connections

# Default mailbox identifier and timeouts
GMAIL_DEFAULT_ACCOUNT_ID=default
GMAIL_OAUTH_STATE_TTL_SECONDS=600
GMAIL_HTTP_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# 7. Asynchronous Worker & Queue Configuration
# -----------------------------------------------------------------------------
# Number of concurrent execution jobs handled by the background worker
WORKER_CONCURRENCY=5

# Polling interval in seconds when checking for queued jobs in MongoDB
WORKER_POLL_INTERVAL_SECONDS=2

# Maximum automatic retry attempts for transiently failing external actions
WORKER_MAX_RETRIES=3

# Rate limiting: max actions allowed per minute per user/integration
RATE_LIMIT_PER_MINUTE=60

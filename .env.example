# =============================================================================
# Core application
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_support_db
CHROMA_PERSIST_DIRECTORY=./chroma_db
LLM_MODEL=gemini-2.5-flash
# HF_TOKEN=your_huggingface_token_here (Optional)


# =============================================================================
# Outbound email provider
# =============================================================================
# Which transport the application sends through.
#   mock  -> default. Nothing leaves the process. Use for local dev and CI.
#   gmail -> Gmail API over OAuth 2.0 (requires the block below).
#
# There is no SMTP username/password transport. Mailbox passwords are never
# accepted or stored by this system.
EMAIL_PROVIDER=mock


# =============================================================================
# Gmail integration - Google Cloud OAuth 2.0 setup
# =============================================================================
#
# One-time setup in Google Cloud Console (https://console.cloud.google.com):
#
#   1. Create or select a project.
#
#   2. APIs & Services -> Library -> enable "Gmail API".
#
#   3. APIs & Services -> OAuth consent screen:
#        - User type: "Internal" if everyone using this is in your Workspace,
#          otherwise "External".
#        - Fill in app name, support email and developer contact email.
#        - Add these scopes:
#              https://www.googleapis.com/auth/gmail.send
#              https://www.googleapis.com/auth/gmail.metadata
#              openid
#              email
#        - gmail.send and gmail.metadata are RESTRICTED scopes. An External app
#          must pass Google's verification (including a security assessment)
#          before it can be used outside the test-user list. While unverified,
#          add each mailbox under "Test users" -- up to 100.
#
#   4. APIs & Services -> Credentials -> Create credentials
#        -> OAuth client ID -> Application type: "Web application".
#        - Authorized redirect URIs: add the EXACT value of
#          GOOGLE_OAUTH_REDIRECT_URI below. Google matches this string byte for
#          byte, including scheme, port and trailing path.
#        - Copy the client ID and client secret into the variables below.
#
#   5. Generate the token encryption key (see GMAIL_TOKEN_ENCRYPTION_KEY).
#
#   6. Start the backend, then POST /api/integrations/gmail/connect and open the
#      returned authorization_url in a browser.
#
# Client ID from the "Web application" OAuth client.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Client secret from the same OAuth client. Server-side only: this value must
# never be shipped to the frontend or committed to version control.
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Must match an "Authorized redirect URI" on the OAuth client exactly.
#   Local:      http://localhost:8000/api/integrations/gmail/callback
#   Production: https://your-api-domain.com/api/integrations/gmail/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback

# Encryption key for OAuth tokens at rest (Fernet, 32 url-safe base64 bytes).
# REQUIRED before any mailbox can be connected: without it the integration
# refuses to store credentials rather than writing tokens in the clear.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates every stored connection; mailboxes must reconnect.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional. Space- or comma-separated scope override. Leave blank for the
# default set (gmail.send, gmail.metadata, openid, email). Dropping
# gmail.metadata still allows sending, but delivery metadata (RFC 822
# Message-ID, labels, internal timestamp) will not be read back.
GMAIL_SCOPES=

# Optional. Where the OAuth callback sends the browser after a successful
# connect, e.g. http://localhost:3000/settings/integrations
# Leave blank to return a small JSON receipt instead of redirecting.
GMAIL_OAUTH_SUCCESS_REDIRECT=

# Optional. Identifier for the connected mailbox when a request does not name
# one. Change this only if you intend to connect multiple mailboxes.
GMAIL_DEFAULT_ACCOUNT_ID=default

# Optional. Lifetime of a pending OAuth `state` value, in seconds.
GMAIL_OAUTH_STATE_TTL_SECONDS=600

# Optional. Timeout for Google/Gmail HTTP calls, in seconds.
GMAIL_HTTP_TIMEOUT_SECONDS=20


# =============================================================================
# Optional: outbound voice (Twilio)
# =============================================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
